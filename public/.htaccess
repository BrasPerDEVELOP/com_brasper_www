Options -Indexes

# Oculta la versión del servidor en las cabeceras/errores (defensa en profundidad).
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Prerender: portada por idioma y raíz.
  #    VA ANTES de la regla de carpetas existentes: la carpeta /pr (y /es, /en) existe
  #    por los sub-HTML (blog.html, faq.html) y no tiene índice propio, así que la regla
  #    de carpetas la trataría como directorio sin index -> 403. Reescribiendo primero a
  #    {idioma}/index.html se evita ese 403.
  RewriteRule ^$ pr/index.html [L]
  RewriteRule ^(es|en|pr)/?$ $1/index.html [L]
  RewriteRule ^(es|en|pr)/faq/?$ $1/faq.html [L]
  RewriteRule ^(es|en|pr)/blog/?$ $1/blog.html [L]

  # 2) Archivos/carpetas existentes se sirven directamente (assets, HTML prerenderizado).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Rutas SPA válidas con contenido dinámico -> index.html (200):
  #    blog (redirección), detalle de artículo, login/registro y dashboard.
  RewriteRule ^blog(/.*)?$ index.html [L]
  RewriteRule ^(es|en|pr)/blog/[^/]+/?$ index.html [L]
  RewriteRule ^(es|en|pr)/(auth|register)/?$ index.html [L]
  RewriteRule ^dashboard(/.*)?$ index.html [L]

  # 4) Cualquier otra ruta no reconocida -> 404 real (elimina el soft 404).
  #    ErrorDocument (abajo) sirve la SPA para mostrar la página 404 (noindex) con estado 404.
  RewriteRule ^ - [R=404,L]
</IfModule>

# La SPA se muestra con estado HTTP 404 para rutas inexistentes (evita soft 404).
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # X-XSS-Protection está obsoleto; el valor recomendado hoy es 0 (se confía en CSP).
  Header always set X-XSS-Protection "0"

  # HSTS: fuerza HTTPS durante 1 año. El sitio ya es HTTPS-only.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Limita APIs sensibles del navegador que el sitio no usa.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # Áreas privadas: nunca deben indexarse aunque devuelvan el HTML de la SPA.
  SetEnvIf Request_URI "^/dashboard" IS_PRIVATE
  Header always set X-Robots-Tag "noindex, nofollow" env=IS_PRIVATE

  # Content-Security-Policy: validar en staging antes de forzar. Se deja en modo
  # Report-Only para no romper GTM/GA/Ads/Meta/Cloudinary/n8n/API en producción.
  # Cuando esté validada, duplicar como "Content-Security-Policy" (sin -Report-Only).
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://connect.facebook.net https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://apibras.finzeler.com https://media.ingenitechsac.workers.dev https://www.google-analytics.com https://region1.google-analytics.com https://res.cloudinary.com; frame-src https://www.googletagmanager.com https://td.doubleclick.net; base-uri 'self'"

  # site.webmanifest debe servirse como manifest, no como text/plain.
  <FilesMatch "\.webmanifest$">
    Header set Content-Type "application/manifest+json; charset=utf-8"
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|gif|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML sin cache agresivo
  ExpiresByType text/html "access plus 0 seconds"

  # Assets versionados (Vite) con cache largo
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>
